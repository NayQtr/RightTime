{
  "$description": "HerZone Qatar app — design tokens v0.4 (W3C Design Tokens format). Import into Figma via Tokens Studio or Figma Variables (collections: color/light, color/dark, type/ar, type/en, space, radius, elevation, motion).",
  "$contrastPairs": [
    ["text", "bg", 4.5], ["text", "surface", 4.5], ["textMuted", "bg", 4.5], ["textMuted", "surface", 4.5],
    ["onPrimary", "primary", 4.5], ["primary", "bg", 4.5], ["primary", "surface", 4.5],
    ["success", "surface", 4.5], ["warning", "surface", 4.5], ["danger", "surface", 4.5], ["info", "surface", 4.5],
    ["onDanger", "danger", 4.5], ["border", "surface", 1.5], ["borderStrong", "surface", 3.0],
    ["focus", "bg", 3.0], ["focus", "surface", 3.0], ["textDisabled", "surface", 3.0],
    ["onCta", "cta", 4.5], ["onCta", "ctaEnd", 4.5], ["text", "surfaceSunken", 4.5], ["textMuted", "surfaceSunken", 4.5],
    ["seatInk", "seat", 4.5], ["primary", "surfaceSunken", 4.5], ["primary", "primarySubtle", 4.5], ["text", "primarySubtle", 4.5], ["borderStrong", "bg", 3.0]
  ],
  "color": {
    "light": {
      "bg":           { "$type": "color", "$value": "#F2D9ED", "$description": "App background: almond blossom («زهر اللوز») in light mode, enchanting violet («البنفسجي الساحر») in dark mode" },
      "surface":      { "$type": "color", "$value": "#FBF1F8", "$description": "Cards, sheets, inputs" },
      "surfaceSunken":{ "$type": "color", "$value": "#E7C6DF", "$description": "Grouped sections, skeletons" },
      "text":         { "$type": "color", "$value": "#2A1F29" },
      "textMuted":    { "$type": "color", "$value": "#634D60", "$description": "Secondary text, helper text" },
      "textDisabled": { "$type": "color", "$value": "#8E768B", "$description": "Disabled labels only (exempt from 4.5:1, kept ≥ 3:1)" },
      "primary":      { "$type": "color", "$value": "#3A2C39", "$description": "Enchanting violet (almond blossom in dark mode) — the one accent: primary actions, selected states" },
      "primaryHover": { "$type": "color", "$value": "#2A1F29" },
      "primarySubtle":{ "$type": "color", "$value": "#E1BFD8", "$description": "Selected option card background" },
      "onPrimary":    { "$type": "color", "$value": "#FBF1F8" },
      "border":       { "$type": "color", "$value": "#D9B9D1", "$description": "Decorative dividers (not a UI boundary)" },
      "borderStrong": { "$type": "color", "$value": "#8A6C86", "$description": "Input and option-card boundaries (≥ 3:1)" },
      "focus":        { "$type": "color", "$value": "#2A1F29", "$description": "2px focus ring + 2px offset (ink, not blue)" },
      "success":      { "$type": "color", "$value": "#1F6B3A" },
      "warning":      { "$type": "color", "$value": "#8A5600" },
      "danger":       { "$type": "color", "$value": "#A3302B" },
      "onDanger":     { "$type": "color", "$value": "#FBF1F8" },
      "info":         { "$type": "color", "$value": "#35607A" },
      "cta":          { "$type": "color", "$value": "#3A2C39", "$description": "Primary call-to-action fill (= primary; no gradient)" },
      "ctaEnd":       { "$type": "color", "$value": "#3A2C39", "$description": "Kept for compatibility (= cta)" },
      "onCta":        { "$type": "color", "$value": "#FBF1F8" },
      "seat":         { "$type": "color", "$value": "#B07AA1", "$description": "Table motif seats only (second warm tone, never a surface)" },
      "seatInk":      { "$type": "color", "$value": "#1F161E" }
    },
    "dark": {
      "bg":           { "$type": "color", "$value": "#3A2C39" },
      "surface":      { "$type": "color", "$value": "#463645" },
      "surfaceSunken":{ "$type": "color", "$value": "#302430" },
      "text":         { "$type": "color", "$value": "#FBF1F8" },
      "textMuted":    { "$type": "color", "$value": "#F2D9ED" },
      "textDisabled": { "$type": "color", "$value": "#BFA6BB" },
      "primary":      { "$type": "color", "$value": "#F2D9ED" },
      "primaryHover": { "$type": "color", "$value": "#FBEAF6" },
      "primarySubtle":{ "$type": "color", "$value": "#2A1F29" },
      "onPrimary":    { "$type": "color", "$value": "#2A1F29" },
      "border":       { "$type": "color", "$value": "#6E586C" },
      "borderStrong": { "$type": "color", "$value": "#A8909F" },
      "focus":        { "$type": "color", "$value": "#FBF1F8" },
      "success":      { "$type": "color", "$value": "#A9E3B8" },
      "warning":      { "$type": "color", "$value": "#F5CD84" },
      "danger":       { "$type": "color", "$value": "#FFC4BA" },
      "onDanger":     { "$type": "color", "$value": "#2A1F29" },
      "info":         { "$type": "color", "$value": "#B3D6EE" },
      "cta":          { "$type": "color", "$value": "#F2D9ED" },
      "ctaEnd":       { "$type": "color", "$value": "#F2D9ED" },
      "onCta":        { "$type": "color", "$value": "#2A1F29" },
      "seat":         { "$type": "color", "$value": "#D9A3C9" },
      "seatInk":      { "$type": "color", "$value": "#1F161E" }
    }
  },
  "font": {
    "family": {
      "ar": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "Noto Sans Arabic", "system-ui", "sans-serif"], "$description": "Self-hosted (qatar/web/fonts); includes Latin" },
      "en": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "system-ui", "sans-serif"] },
      "numeric": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "system-ui", "sans-serif"], "$description": "Prices, times, booking refs, OTP (Western digits, tabular) in both locales" },
      "displayAr": { "$type": "fontFamily", "$value": ["Alexandria", "IBM Plex Sans Arabic", "sans-serif"], "$description": "Titles (600) and large numerals (700/800), self-hosted" },
      "displayEn": { "$type": "fontFamily", "$value": ["Alexandria", "IBM Plex Sans Arabic", "sans-serif"], "$description": "Titles (600) and large numerals (700/800), self-hosted" }
    },
    "weight": { "regular": { "$type": "fontWeight", "$value": 400 }, "medium": { "$type": "fontWeight", "$value": 500 }, "semibold": { "$type": "fontWeight", "$value": 600 }, "bold": { "$type": "fontWeight", "$value": 700 }, "black": { "$type": "fontWeight", "$value": 800 } }
  },
  "type": {
    "$description": "Arabic runs ~1 step larger with taller line-height than Latin at the same role; letter-spacing is 0 for Arabic (never track Arabic).",
    "ar": {
      "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.displayAr}", "fontSize": "32px", "lineHeight": 1.3,  "fontWeight": "{font.weight.semibold}",    "letterSpacing": "0" } },
      "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.family.displayAr}", "fontSize": "26px", "lineHeight": 1.35, "fontWeight": "{font.weight.semibold}",    "letterSpacing": "0" } },
      "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.family.displayAr}", "fontSize": "20px", "lineHeight": 1.4,  "fontWeight": "{font.weight.semibold}",     "letterSpacing": "0" } },
      "body":    { "$type": "typography", "$value": { "fontFamily": "{font.family.ar}", "fontSize": "16px", "lineHeight": 1.65, "fontWeight": "{font.weight.regular}",  "letterSpacing": "0" } },
      "label":   { "$type": "typography", "$value": { "fontFamily": "{font.family.ar}", "fontSize": "15px", "lineHeight": 1.5,  "fontWeight": "{font.weight.medium}",   "letterSpacing": "0" } },
      "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.ar}", "fontSize": "13px", "lineHeight": 1.55, "fontWeight": "{font.weight.regular}",  "letterSpacing": "0" } }
    },
    "en": {
      "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.displayEn}", "fontSize": "32px", "lineHeight": 1.15, "fontWeight": "{font.weight.semibold}",    "letterSpacing": "0em" } },
      "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.family.displayEn}", "fontSize": "24px", "lineHeight": 1.2,  "fontWeight": "{font.weight.semibold}",    "letterSpacing": "0em" } },
      "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.family.displayEn}", "fontSize": "19px", "lineHeight": 1.3,  "fontWeight": "{font.weight.semibold}",     "letterSpacing": "0" } },
      "body":    { "$type": "typography", "$value": { "fontFamily": "{font.family.en}", "fontSize": "16px", "lineHeight": 1.5,  "fontWeight": "{font.weight.regular}",  "letterSpacing": "0" } },
      "label":   { "$type": "typography", "$value": { "fontFamily": "{font.family.en}", "fontSize": "15px", "lineHeight": 1.4,  "fontWeight": "{font.weight.medium}",   "letterSpacing": "0" } },
      "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.en}", "fontSize": "13px", "lineHeight": 1.45, "fontWeight": "{font.weight.regular}",  "letterSpacing": "0.005em" } }
    }
  },
  "space": {
    "$description": "4-px base. Use logical properties (padding-inline-start/end) so RTL mirrors automatically.",
    "0": { "$type": "dimension", "$value": "0px" }, "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" }, "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" }, "8": { "$type": "dimension", "$value": "32px" }, "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "gutter": { "$type": "dimension", "$value": "16px", "$description": "Screen side padding at 360px" },
    "touchTarget": { "$type": "dimension", "$value": "48px", "$description": "Minimum hit area for every control" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "10px", "$description": "Small controls, inputs" },
    "md": { "$type": "dimension", "$value": "16px", "$description": "Buttons, options, cards" },
    "lg": { "$type": "dimension", "$value": "16px", "$description": "Cards, option cards" },
    "xl": { "$type": "dimension", "$value": "24px", "$description": "Bottom sheets (top corners only)" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "elevation": {
    "0": { "$type": "shadow", "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }, "$description": "Flat (default cards use border, not shadow)" },
    "1": { "$type": "shadow", "$value": { "color": "#1C1A171A", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }, "$description": "Raised card, sticky price strip" },
    "2": { "$type": "shadow", "$value": { "color": "#1C1A1724", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }, "$description": "Menus, toasts" },
    "3": { "$type": "shadow", "$value": { "color": "#1C1A172E", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }, "$description": "Bottom sheets, dialogs (+ scrim #000 40 %)" },
    "darkNote": { "$type": "other", "$value": "In dark theme shadows are not visible; raise surfaces by one step of lightness (surface → #26221E for level 2–3) instead." }
  },
  "motion": {
    "fast":   { "$type": "duration", "$value": "120ms" },
    "base":   { "$type": "duration", "$value": "200ms" },
    "slow":   { "$type": "duration", "$value": "320ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "reduced": { "$type": "other", "$value": "prefers-reduced-motion: all durations → 0ms except opacity fades ≤ 120ms; success check is static." }
  }
}
