<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===================================================================
         NO android.permission.INTERNET.
         This launcher has no network access at all. It cannot phone home,
         cannot fetch an ad, and cannot report what you watch, because the
         OS will not let it open a socket. That is the whole design.
         =================================================================== -->

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Needed to enumerate HDMI / passthrough inputs for source switching. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <application
        android:label="RightTime"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/RightTimeTheme"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME makes this selectable as the TV's home screen. -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LEANBACK_LAUNCHER makes it visible in the Android TV UI. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/RightTimeTheme" />
    </application>
</manifest>
